# Üretim build (Vercel vb.): CheapShark + auth API’nin tam HTTPS adresi.
# Sonda /api olmalı (kod zaten /cheapshark ekliyor).
# Örnek: https://priceplay-api-xxxx.onrender.com/api
VITE_API_BASE_URL=

# İsteğe bağlı: Steam’i başka yerde proxy’liyorsan. Boşsa VITE_API_BASE_URL + /steam kullanılır.
# VITE_STEAM_API_BASE=https://...
