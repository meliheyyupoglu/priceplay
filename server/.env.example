PORT=3000

# Core strategy
CACHE_TTL_SECONDS=86400
CHEAPSHARK_UPSTREAM_ENABLED=1
CHEAPSHARK_BACKGROUND_REFRESH=0
CHEAPSHARK_ALLOW_UPSTREAM_GAMES_ID=1
CHEAPSHARK_ALLOW_UPSTREAM_GAMES_TITLE=1
STEAM_UPSTREAM_ENABLED=0
CHEAPSHARK_DAILY_REFRESH_CRON=0 5 * * *

# Upstream guards
UPSTREAM_MIN_INTERVAL_MS=450
UPSTREAM_TIMEOUT_MS=18000
UPSTREAM_MAX_RETRIES=2
UPSTREAM_GAME_DETAIL_EXTRA_RETRIES=2
UPSTREAM_BACKOFF_BASE_MS=500
MAX_RETRY_AFTER_MS=8000

# Request throttling (IP based)
EXPENSIVE_READS_PER_MINUTE=90
SEARCH_REQUESTS_PER_MINUTE=35
SEARCH_MIN_QUERY_LENGTH=2

# Optional
DATABASE_URL=
PRICE_CHECK_CRON=0 9 * * *
WARMUP_SECRET=
WARMUP_MAX_GAME_IDS=240
WARMUP_SEARCH_TITLES=elden,portal,gta
WARMUP_CATEGORY_TITLES=action,adventure,rpg,strategy,shooter,indie,simulation,sports,racing
FIREBASE_SERVICE_ACCOUNT_PATH=
